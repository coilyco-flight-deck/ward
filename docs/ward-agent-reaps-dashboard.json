              },
              "having": { "expression": "" },
              "limit": 200,
              "orderBy": [{ "columnName": "timestamp", "order": "asc" }],
              "pageSize": 200,
              "queryName": "A",
              "selectColumns": [
                { "dataType": "string", "isColumn": true, "key": "timestamp", "type": "tag" },
                { "dataType": "string", "isColumn": false, "key": "body", "type": "tag" },
                { "dataType": "string", "isColumn": false, "key": "container", "type": "tag" },
                { "dataType": "string", "isColumn": false, "key": "repo", "type": "tag" },
                { "dataType": "string", "isColumn": false, "key": "issue", "type": "tag" },
                { "dataType": "string", "isColumn": false, "key": "actor", "type": "tag" }
              ],
              "stepInterval": 60
