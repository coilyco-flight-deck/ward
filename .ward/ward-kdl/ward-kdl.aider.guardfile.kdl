// aider launcher for ward-kdl, mounted at `ward-kdl agents aider`
// (cli-guard execverb, exec dialect). aider authenticates via API keys, so it
// has no login verb: `launch` runs the bare binary, `headless` runs `--message`
// for a single non-interactive turn. See ../../docs/ward-kdl/ward-kdl.aider.guardfile.md.
wrap ward-kdl agents aider {
    exec aider
    can run launch {
        argv
        describe "interactive session (bare aider)"
    }
    can run headless {
        argv --message
        describe "single non-interactive message; pass it as args"
    }
    // Back-link footer (ward#309): doc-link regenerates a `## See also` section
    // into this guardfile's reference doc, so it survives every rebuild wipe-proof.
    doc-link "../ward-kdl.md" ward-kdl.md "the build-time authoring layer behind this surface"
    doc-link "../ward-kdl-surface.md" ward-kdl-surface.md "the full generated verb surface, area by area"
}
