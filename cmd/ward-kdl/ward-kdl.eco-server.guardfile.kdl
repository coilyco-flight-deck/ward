// ward-kdl ops eco server - the Linux prod half of the Eco content pipeline
// (cli-guard execverb, exec dialect + complex actions). The transport is the
// declared ssh hop to kai-server (ward#585: reuse the execverb ssh primitive,
// never invent plumbing); every step runs a pinned infra script on the box as
// kai, and the stage step's `bin scp` override carries the tested working copy
// up (ward#584) - a multi-binary pipeline, one declared area.
//
// The promote restart is the bare-unit `sudo systemctl restart eco-server`
// matching the sudoers/kai-game-servers NOPASSWD grant (a .service suffix
// misses sudo's literal argv match and stalls TTY-less). This action targets
// the LIVE server: the sibling eco-native guardfile is the local test half,
// and infra's docs/ops-eco.md holds the host prereqs + env overrides.
wrap ward-kdl ops eco server {
    exec ssh {
        argv-prefix -o "BatchMode=yes" kai@kai-server
    }
    can run snapshot {
        argv bash "/home/kai/projects/coilyco-flight-deck/infrastructure/scripts/eco-server-snapshot.sh"
        describe "copy live Mods/+Configs/ aside on kai-server; prints the snapshot id as the final line"
    }
    can run stage-clean {
        argv rm -rf "/tmp/ward-eco-apply"
        sealed
        describe "drop any stale staged upload so scp lands a fresh tree"
    }
    can run stage {
        bin scp
        argv -o "BatchMode=yes" -r
        describe "upload the tested working-copy tree to the kai-server staging dir (ward#584)"
    }
    can run apply {
        argv bash "/home/kai/projects/coilyco-flight-deck/infrastructure/scripts/eco-server-apply-staged.sh"
        describe "merge the staged working-copy Mods/+Configs/ into the live tree"
    }
    can run restart {
        argv sudo systemctl restart eco-server
        sealed
        describe "restart the live unit (bare name: matches the NOPASSWD sudoers grant)"
    }
    can run await {
        argv bash "/home/kai/projects/coilyco-flight-deck/infrastructure/scripts/eco-server-await-healthy.sh"
        describe "bounded wait for a healthy post-restart boot (Eco boots take minutes)"
    }
    can run health {
        argv bash "/home/kai/projects/coilyco-flight-deck/infrastructure/scripts/eco-server-health-check.sh"
        describe "one instant probe: service_active / journal_clean / server_ready key=val"
    }
    can run rollback {
        argv bash "/home/kai/projects/coilyco-flight-deck/infrastructure/scripts/eco-server-rollback.sh"
        describe "restore a snapshot, restart, and VERIFY recovery (non-zero when still unhealthy)"
    }
    action promote {
        describe "guarded LIVE promote: snapshot, stage+apply the tested working copy, restart, await ready, canary-watch; any failure rolls back to the snapshot"
        input src {
            positional
            required
            help "working-copy root holding Mods/ (the tree the native gate tested)"
        }
        call run snapshot {
            as snap
            compensate run rollback {
                args $snap.last_line
            }
        }
        call run stage-clean
        call run stage {
            args $src "kai@kai-server:/tmp/ward-eco-apply"
        }
        call run apply
        call run restart
        call run await
        canary run health {
            every "20s"
            window "60s"
            degraded-when "exit_code != `0`"
            as health
        }
    }
    // Back-link footer (ward#309): doc-link regenerates a `## See also` section
    // into this guardfile's reference doc, so it survives every rebuild wipe-proof.
    doc-link "../ward-kdl.md" ward-kdl.md "the build-time authoring layer behind this surface"
    doc-link "../ward-kdl-surface.md" ward-kdl-surface.md "the full generated verb surface, area by area"
}
