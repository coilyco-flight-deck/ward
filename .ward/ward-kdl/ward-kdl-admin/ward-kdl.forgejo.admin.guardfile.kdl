// Forgejo ADMIN tier - the top of the read ⊂ write ⊂ admin chain (ward#240), now
// carrying the real curated surface ported from the monolith (ward#278, Phase 1).
// The bare `can delete *` wildcard is gone: this tier lists the explicit delete
// leaves of the curated subset instead, so it grants exactly the curated
// destructive verbs, not every delete-able swagger resource.
//
// `inherit` composes the whole write tier (which itself composes read), so this
// file only adds the irreversible delete verbs the lower tiers withhold. Every
// read/write leaf, every `never` denial (deny inherits up, cli-guard v0.72.0),
// and the spec/base-url singletons all arrive through the chain. The result is
// the full curated CRUD surface: `ward-kdl-admin` mounts exactly what the monolith
// mounts (the Phase-2 candidate for `ward ops forgejo`, ward#92).
//
// "admin" here means the irreversible REST verb (delete), not Forgejo's
// server-side maintenance verbs.
//
// Actions are child-local (not inherited, cli-guard v0.72.0), so all four curated
// actions are re-declared verbatim here so admin fully matches the monolith
// surface (ward#278). See ../../../docs/ward-kdl/ward-kdl.forgejo.admin.guardfile.md.
wrap ward-kdl-admin ops forgejo {
    inherit "../ward-kdl-write/ward-kdl.forgejo.write.guardfile.kdl"
    // Scope gate: re-declared per tier (harmless dedup) so it reads present in
    // this tier's own guardfile and generated doc.
    restrict owner matches example*
    // repos: the irreversible delete. fork/archive/unarchive stay denied by the
    // inherited read-tier `never`s.
    can delete repo {
        describe "irreversible: deletes the repo and all its data"
    }
    // org-labels: delete an org-level label.
    can delete org-label
    // milestones: delete a milestone.
    can delete milestone
    // releases: delete a release.
    can delete release
    // issue-comments: delete a single issue comment by ID, the cleanup path a stale
    // reservation road-block needed (ward#570). `delete issue` stays denied (inherited).
    can delete issue-comment {
        op issueDeleteComment
        describe "delete a single issue comment by its comment ID (DELETE /repos/{owner}/{repo}/issues/comments/{id}). op pinned for the same reason `list issue-comment` pins issueGetComments - the bare `delete issue-comment` convention does not reach issueDeleteComment. This is the cleanup path a stale reservation road-block needed (ward#570): a `ward agent` launch that dies before its container comes up posts a release-marker comment to retract the hold, but the orphaned `ward-agent-reservation` comment itself could only be removed by hand until this leaf. {owner}-scoped by the example gate above; irreversible, so it is a targeted-ID delete, never a bulk sweep."
    }
    // list-all issue: read-family action re-declared verbatim (child-local) so admin
    // stays a superset of the lower tiers and matches the monolith (ward#278).
    action list-all issue {
        describe "List all issues by auto-paginating issue list."
        input owner {
            positional
            required
            help "repo owner"
        }
        input repo {
            positional
            required
            help "repo name"
        }
        input state {
            flag
            help "whether issue is open or closed"
        }
        input labels {
            flag
            help "comma separated list of labels"
        }
        input q {
            flag
            help "search string"
        }
        input type {
            flag
            help "filter by type (issues / pulls)"
        }
        input milestones {
            flag
            help "comma separated list of milestone names or ids"
        }
        input since {
            flag
            help "Only show items updated after the given RFC3339 time"
        }
        input before {
            flag
            help "Only show items updated before the given RFC3339 time"
        }
        input created_by {
            flag
            help "Only show items created by the given user"
        }
        input assigned_by {
            flag
            help "Only show items assigned by the given user"
        }
        input mentioned_by {
            flag
            help "Only show items mentioning the given user"
        }
        input limit {
            flag
            help "page size of results"
        }
        input sort {
            flag
            help "Type of sort"
        }
        collect list issue {
            args {
                owner $owner
                repo $repo
                state $state
                labels $labels
                q $q
                type $type
                milestones $milestones
                since $since
                before $before
                created_by $created_by
                assigned_by $assigned_by
                mentioned_by $mentioned_by
                sort $sort
            }
            page-param page
            limit-param limit
            limit $limit
            default-limit "50"
            as issues
        }
    }
    // view issue: read-family shadow action re-declared verbatim (child-local) so an
    // admin-tier view still returns the comment thread (ward#170), matching read.
    action view issue {
        describe "View an issue with its full comment thread (issue + comments). Shadows the generated `issue view` (same 3-arg signature) so a view never misses the comments - the ward#170 failure mode where an agent reads the body and skips the thread. ward#225: ward's CLI renders this through a lean projection that collapses every commenter to its login literal, so a multi-comment issue no longer repeats each commenter's full profile once per comment; the guardfile shape is unchanged."
        input owner {
            positional
            required
            help "repo owner"
        }
        input repo {
            positional
            required
            help "repo name"
        }
        input index {
            positional
            required
            help "issue number"
        }
        call view issue {
            args {
                owner $owner
                repo $repo
                index $index
            }
            as issue
        }
        call list issue-comment {
            args {
                owner $owner
                repo $repo
                index $index
            }
            as comments
        }
    }
    // move-issue: copy title/body to a target repo, back-link, then CLOSE the
    // source (never delete). Write-family action re-declared verbatim (child-local).
    action move-issue {
        describe "Move an issue to another repo (copy title/body, back-link, close source). Never deletes."
        input source {
            positional
            required
            help "source owner/name"
        }
        input index {
            positional
            required
            help "source issue number"
        }
        input target {
            positional
            required
            help "target owner/name"
        }
        call view issue {
            args {
                owner-repo $source
                index $index
            }
            as src
        }
        call create issue {
            args {
                owner-repo $target
                title $src.title
                body $src.body
            }
            as dst
        }
        call comment issue {
            args {
                owner-repo $source
                index $index
                body $dst.html_url
            }
        }
        call close issue {
            args {
                owner-repo $source
                index $index
            }
        }
    }
    // comment issue: shadow the leaf so a comment on a CLOSED issue warns instead
    // of posting silently (ward#380). Write-family action re-declared verbatim.
    action comment issue {
        describe "Post a comment on an issue, warning when the issue is closed (ward#380). Shadows the generated `issue comment` leaf (same 3-arg + --body signature): it GETs the issue to read its state, posts the comment, then `fail-when`s on state=='closed' so commenting on a closed issue exits non-zero instead of passing silently. The comment IS still created - the non-zero exit and the issue body in the output are the warning that the target was closed, not a block on the post. Renders {comment, issue} together like every mount call action."
        input owner {
            positional
            required
            help "repo owner"
        }
        input repo {
            positional
            required
            help "repo name"
        }
        input index {
            positional
            required
            help "issue number"
        }
        input body {
            flag
            required
            help "The body of the comment"
        }
        call get issue {
            args {
                owner $owner
                repo $repo
                index $index
            }
            as issue
        }
        call comment issue {
            args {
                owner $owner
                repo $repo
                index $index
                body $body
            }
            as comment
        }
        fail-when "$issue.state == 'closed'"
    }
    // Back-link footer (ward#309): doc-link regenerates a `## See also` section
    // into this guardfile's reference doc, so it survives every rebuild wipe-proof.
    doc-link "../ward-kdl.md" ward-kdl.md "the build-time authoring layer behind this surface"
    doc-link "../ward-kdl-surface.md" ward-kdl-surface.md "the full generated verb surface, area by area"
}
