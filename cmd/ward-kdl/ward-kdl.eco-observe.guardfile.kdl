// ward-kdl ops eco observe - the READ-ONLY window into the live Eco prod server
// on kai-server (cli-guard execverb, exec dialect). Sibling of the eco-server
// WRITE promote pipeline (ward-kdl.eco-server.guardfile.kdl): the same declared
// ssh hop to kai@kai-server (ward#585: reuse the execverb ssh primitive, never
// invent plumbing), but every verb here is NON-MUTATING - read unit status, tail
// the journal, list Mods/ and Configs/, cat a config file. No restart, no apply,
// no snapshot: those stay on the write pipeline, which the warded director must
// DISPATCH, never run itself (ward#547 scope guardrail: read-only observe only).
//
// ward#547: the warded director now holds the live-observe set (aws + tailscale)
// in ../ward-kdl.fleet.kdl's `roles` block, so a director container joins the
// tailnet (host-net on Linux, docs/agent-host-net.md) and reaches kai-server.
// This surface is what it then reads - the safe second-set-of-eyes the director
// gains once the tailnet route lands: audit the live mod set (eco-ops#15), confirm
// a config landed (eco-ops#21), confirm EcoTelemetry is flowing (eco-ops#26).
//
// The four inspection verbs are `sealed` (no trailing caller args - the pinned
// command forwards exactly), so a read can never be widened into an arbitrary
// remote command. `read-config` is the one verb that takes a caller path; its
// `deny-when arg0` guard blocks path traversal and the obvious on-host secret
// paths, and `cat` is non-mutating regardless.
//
// Host prereq (shared with eco-server): reading a SYSTEM unit's journal needs kai
// in the systemd-journal (or adm) group - see infra's docs/ops-eco.md. The Mods/
// and Configs/ paths pin the infra health script's default SERVER_DIR
// (/home/kai/Steam/steamapps/common/EcoServer).
wrap ward-kdl ops eco observe {
    exec ssh {
        argv-prefix -o "BatchMode=yes" kai@kai-server
    }
    can run status {
        argv systemctl status eco-server.service --no-pager
        sealed
        describe "live systemd unit state for eco-server.service (read-only; bare name matches the unit, --no-pager for a full capture)"
    }
    can run logs {
        argv journalctl -u eco-server.service -n "500" --no-pager
        sealed
        describe "tail the last 500 journal lines for eco-server.service (read-only; watch a restart, eco-ops#24/#26)"
    }
    can run mods {
        argv ls -la "/home/kai/Steam/steamapps/common/EcoServer/Mods"
        sealed
        describe "list the live Mods/ tree - audit the installed mod set + DLL versions (eco-ops#15)"
    }
    can run configs {
        argv ls -la "/home/kai/Steam/steamapps/common/EcoServer/Configs"
        sealed
        describe "list the live Configs/ tree - confirm a config file landed (eco-ops#21)"
    }
    can run read-config {
        argv cat
        deny-when arg0 matches *..* "*/.ssh/*" *id_rsa* *id_ed25519* "*/.aws/*" *credential* *secret*
        describe "cat one live Eco config file, e.g. .../Configs/EcoTelemetry.json (eco-ops#26) or a Configs/*.eco (eco-ops#21). Pass the absolute path; traversal + obvious-secret paths are denied, and cat is read-only regardless."
    }
    // Back-link footer (ward#309): doc-link regenerates a `## See also` section
    // into this guardfile's reference doc, so it survives every rebuild wipe-proof.
    doc-link "../ward-kdl.md" ward-kdl.md "the build-time authoring layer behind this surface"
    doc-link "../ward-kdl-surface.md" ward-kdl-surface.md "the full generated verb surface, area by area"
}
