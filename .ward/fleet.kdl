// Fleet config for ward (cli-guard fleetconfig, DIALECT 2). This is NOT a
// guardfile: it names which agents the Ward fleet can run and how each one is
// launched (binary, context level, argv shape, model), never a permission. The
// file lives directly in .ward/ and uses the typed parser in cmd/ward/fleet.go
// via pkg/fleetconfig, legibly partitioned from AOSguard operator policy
// (aos#310 §6, ward#415).
//
// The root policy-assets package embeds this single canonical source directly.
//
// The frontier launch shapes are ward-owned built-ins in cmd/ward/agent_fleet.go.
// This bundle is the sparse override layer plus role tuning, not the product
// default source. ward#419 deleted the old agent-adapters.yaml mirror, and the
// contract test (agent_adapter_test.go, TestFleetSwitchesTwoWayPin) still pins
// this policy to the parseMode roster.
//
// POST-#412 roster: `opencode` is the canonical harness key (`qwen` remains only
// as a deprecated --mode alias). The runtime reads this manifest
// (bootstrap defaults + the launcher-facing projection in agent_adapter.go).
fleet {
    schema-version 2
    // defaults mirror the container_bootstrap.go env-default constants: WARD_MODE
    // -> defaults.agent, WARD_GIT_NAME/WARD_GIT_EMAIL -> defaults.attribution.
    defaults {
        agent claude
        attribution name=example-bot email=bot@example.com
    }
    // Sparse frontier override: builtin launch shapes fill the rest.
    agent claude {

    }
    // Per-role capability roster (ward#578) + per-agent model/effort overlay
    // (cli-guard#192, ward#620); overlay precedence in docs/agent-config-overrides.md.
    roles {
        // engineer: no host reach; a cheaper model for parallel fan-out (ward#620).
        role engineer {
            agent claude {
                model claude-fable-5
                name "opal engineer"
                pronouns she
                reasoning-effort medium
            }
            agent codex {
                model gpt-5.4-mini
                name "terran engineer"
                pronouns he
                reasoning-effort medium
            }
        }
        // director owns the live-observe set (aws + tailnet, ward#547); its
        // heartbeat wants the strongest model at 1M context (ward#620).
        role director {
            guardfiles aws.kdl tailscale.kdl
            agent claude {
                model "claude-opus-4-8[1m]"
                name "fabled director"
                pronouns she
                reasoning-effort high
            }
            agent codex {
                model gpt-5.5
                name "solar director"
                pronouns he
                reasoning-effort high
            }
        }
        role qa {
            agent claude {
                model claude-opus-4-8
                name "opal tester"
                pronouns she
                reasoning-effort high
            }
            agent codex {
                model gpt-5.6-terra
                name "terran tester"
                pronouns he
                reasoning-effort high
            }
        }
    }
}
