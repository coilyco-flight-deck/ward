      "panelTypes": "table",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [{ "expression": "count()" }],
              "dataSource": "logs",
              "disabled": false,
              "expression": "A",
              "filter": {
                "expression": "service.name = 'ward-agent' AND stream = 'tool' AND outcome != 'success' AND repo IN $repo AND issue IN $issue AND container IN $container AND actor IN $actor"
              },
              "groupBy": [
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "container", "type": "tag" },
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "repo", "type": "tag" },
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "issue", "type": "tag" },
