// Ward's shipped agent role-definition presets. This is product-default data, not
// a guardfile or a fleet overlay. The embedded copy mirrors this canonical source.
agent-roles {
    role engineer {
        tagline "Implements a ticket end to end."
        capabilities read engineering
        modes "A ref carries that issue detached, fire-and-forget. Freeform text files an issue first, then carries it. Detached-only - interactive work funnels to the director."
        execution-time-limit "90m"
        default-harness claude
        posture code-landing
        merge-authority pull-request-and-merge
    }
    role director {
        tagline "Opens the read-only director surface. Autonomous burndown is opt-in."
        capabilities read project-management
        modes "Attached read-only control surface over a repo's backlog (`--repo` scope). Use `--burndown` or `--drain` for the autonomous heartbeat."
        execution-time-limit none
        default-harness claude
        posture attached
        merge-authority pull-request pull-request-and-merge
    }
    role qa {
        tagline "Inspects a candidate and posts a structured verdict comment."
        capabilities read
        modes "A ref inspects the issue, branch, pull request, and checks, then posts a structured QA verdict comment. Freeform mode is not exposed."
        execution-time-limit "30m"
        default-harness claude
        posture no-code
    }
}
