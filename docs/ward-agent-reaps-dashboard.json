  "version": "v5",
  "widgets": [
    {
      "description": "Recent runs grouped by container, repo, issue, and actor.",
      "id": "recent-runs",
      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "table",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [{ "expression": "count()" }],
              "dataSource": "logs",
              "disabled": false,
              "expression": "A",
              "filter": {
                "expression": "service.name = 'ward-agent' AND stream = 'console' AND repo IN $repo AND issue IN $issue AND container IN $container AND actor IN $actor"
              },
              "groupBy": [
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "container", "type": "tag" },
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "repo", "type": "tag" },
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "issue", "type": "tag" },
                { "dataType": "string", "isColumn": false, "isJSON": false, "key": "actor", "type": "tag" }
              ],
              "having": { "expression": "" },
              "legend": "Runs",
              "limit": 25,
              "orderBy": [{ "columnName": "count()", "order": "desc" }],
              "queryName": "A",
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "queryType": "builder"
      },
      "timePreferance": "GLOBAL_TIME",
      "title": "Recent Runs",
      "yAxisUnit": "none"
    },
    {
      "description": "Console lines in log order for the selected run.",
