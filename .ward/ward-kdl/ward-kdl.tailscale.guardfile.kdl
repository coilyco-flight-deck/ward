// Tailscale ops surface for ward-kdl, driving the vendored tailscale.openapi.yaml
// (OpenAPI 3.1, YAML). This baked copy is an example-safe placeholder; the real
// deployment bundle carries the live tailnet host and API key.
wrap ward-kdl ops tailscale {
    spec tailscale.openapi.yaml
    base-url "example.tailscale.invalid/api/v2"
    auth bearer {
        value ssm "/example/tailscale/api-key"
    }
    // Scope gate: every tailnet-scoped leaf must name an example tailnet.
    restrict tailnet matches example*
    // devices: list and inspect. Deletion is denied - removing a device from the
    // tailnet is disruptive and human-only.
    can list devices
    can get device
    never delete device {
        message "removing a device from the tailnet is disruptive; do it in the admin console"
    }
    // policy file (ACL): read and write. Path is /tailnet/{tailnet}/acl, so both
    // resolve via the operationId fallback (getPolicyFile / setPolicyFile).
    can get policy
    can set policy
    // auth keys: list/create/revoke. Revoking a key (delete) is reversible enough
    // (mint a new one), so it stays allowed.
    can list keys
    can get keys
    can create keys
    can delete keys
    // Back-link footer (ward#309): doc-link regenerates a `## See also` section
    // into this guardfile's reference doc, so it survives every rebuild wipe-proof.
    doc-link "../ward-kdl.md" ward-kdl.md "the build-time authoring layer behind this surface"
    doc-link "../ward-kdl-surface.md" ward-kdl-surface.md "the full generated verb surface, area by area"
}
